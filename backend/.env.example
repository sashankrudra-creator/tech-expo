# ───────────── Tech Expo backend settings ─────────────
# Copy this file to ".env" (same folder) and fill in your values.
# Never commit .env or your Firebase key file to GitHub.

# --- Database ---
# firestore = real Firebase Firestore (needs the key file below)
# memory    = temporary in-memory data for testing, wiped when the server stops
DATABASE=firestore

# Path to the Firebase service-account key you download from Firebase Console
# (Project settings → Service accounts → Generate new private key)
FIREBASE_CREDENTIALS=serviceAccountKey.json
# Optional: paste the whole key JSON here instead of using a file (useful on hosting platforms)
FIREBASE_CREDENTIALS_JSON=

# --- Admin login ---
ADMIN_USERNAME=admin
# Use a strong password. Or set ADMIN_PASSWORD_HASH instead (see README) and leave this blank.
ADMIN_PASSWORD=change-this-password
ADMIN_PASSWORD_HASH=
# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_HOURS=12

# --- Frontend address (CORS). Comma-separate if more than one. ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Registration rules ---
# false = one registration per mobile number. true = siblings can share a parent's number.
ALLOW_DUPLICATE_MOBILE=false
REGISTER_RATE_LIMIT=30 per minute

# --- Unique ID format: PREFIX-XXXXXX ---
ID_PREFIX=TE26
ID_LENGTH=6

# --- Email (SMTP). Leave SMTP_USERNAME blank to turn email off; PDFs still work. ---
# Gmail: host smtp.gmail.com, port 587, use an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Tech Expo 2026

# --- Event details printed on certificates and emails ---
EVENT_NAME=Tech Expo 2026
EVENT_DATE=14 November 2026
EVENT_VENUE=School Auditorium
SCHOOL_NAME=Your School Name
SIGNATORY_LEFT=Principal
SIGNATORY_RIGHT=Event Coordinator
# Logo used on the PDF certificate (PNG or JPG)
CERT_LOGO_PATH=assets/school-logo.png

PORT=5000
